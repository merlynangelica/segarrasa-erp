# Salin menjadi .env lalu isi nilainya
SECRET_KEY=ganti-dengan-string-acak-panjang
# Lokasi file database SQLite (pakai path absolut di server, contoh /home/group1segarrasa/erp/instance/segarrasa_erp.db)
DATABASE_PATH=instance/segarrasa_erp.db
FLASK_DEBUG=0
# Isi 1 jika website sudah memakai HTTPS
SESSION_COOKIE_SECURE=0
